# ============================================
#  KONFIGURASI RYDZZ SHELL (~/.rydzzrc)
#  Simpan file ini di ~/.rydzz_home/.rydzzrc
#  Setiap baris = 1 direktif. Baris '#' diabaikan.
# ============================================

# Warna prompt: green, purple, cyan, yellow, blue, magenta, red, white
# prompt color=green

# Tampilkan banner saat startup (true/false)
# banner=true

# Sertakan hidden files di 'ls' secara default (true/false)
# hidden=false

# Aktifkan auto-cd (ketik nama folder langsung pindah) (true/false)
# auto_cd=true

# Simpan riwayat perintah antar-sesi (true/false)
# history=true

# Definisikan alias khusus Rydzz: alias=<nama>=<perintah>
# alias=cl=clear
# alias=ll=ls -la

# Tambah file ke daftar terproteksi: protected=add:file1,file2
# protected=add:rahasia.txt

# Jalankan command otomatis saat startup shell
# init=clear

# ----- AI PEMANDU (RydzAgent) -----
# Hidupkan/matikan semua fitur AI (true/false)
# ai=true

# API key Google Gemini (gratis): https://aistudio.google.com/apikey
# ai key=

# Model & endpoint (default sudah benar untuk Gemini)
# ai model=gemini-3.6-flash
# ai base=https://generativelanguage.googleapis.com/v1beta/openai

# Nama karakter AI pemandu
# ai nama=RydzAgent

# Kota default untuk perintah weather (tanpa argumen)
# weather city=jakarta
